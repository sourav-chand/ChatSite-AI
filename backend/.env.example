# ── App ─────────────────────────────────────────────
ENVIRONMENT=dev
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-byte-string
FRONTEND_URL=http://localhost:4200
WIDGET_CDN_URL=http://localhost:8000

# ── Database ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://chatsite:chatsite@postgres:5432/chatsite
DATABASE_URL_SYNC=postgresql://chatsite:chatsite@postgres:5432/chatsite

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Qdrant ──────────────────────────────────────────
QDRANT_URL=https://3961f2c3-3c7e-4947-9b9c-e811c9ab8f00.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6NWRjZDA2ZDAtOWY0NC00N2QxLWI5ZTYtOTU1ZDNhOTFjNDRmIn0.c1h1ckW485jnTptg2Q2jmyhDJghMJnGq4l_4U5ZZFKc

# ── AI providers ────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL_CHAT=gpt-4o
OPENAI_MODEL_EMBED=text-embedding-3-small
GOOGLE_API_KEY=
GOOGLE_MODEL_CHAT=gemini-2.0-flash

# ── JWT ─────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ISSUER=chatsite.ai
JWT_AUDIENCE=chatsite-api

# ── Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Email ───────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@chatsite.ai

# ── CORS / Security ─────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost:8000

# ── Crawler defaults ────────────────────────────────
CRAWL_MAX_DEPTH=4
CRAWL_CONCURRENCY=5
CRAWL_REQUEST_DELAY=1.0
CRAWL_USER_AGENT=ChatSiteBot/1.0 (+https://chatsite.ai/bot)
CRAWL_TIMEOUT_SEC=20

# ── Chunking defaults ───────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNKING_STRATEGY=recursive

# ── RAG defaults ────────────────────────────────────
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.72
RAG_RERANK_TOP_K=4
RAG_MAX_QUERY_LEN=500
RAG_LLM_MAX_TOKENS=800
RAG_LLM_TEMPERATURE=0.3
RAG_HISTORY_TURNS=6
RAG_CONTEXT_TOKEN_LIMIT=2000

# ── Rate limits ─────────────────────────────────────
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_API=60/minute

# ── Widget ──────────────────────────────────────────
WIDGET_VERSION=1.0.0
